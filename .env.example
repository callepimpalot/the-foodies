# Client-side (bundled into the app — these are meant to be public)
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Server-side only. These belong in the Netlify environment, NOT in a client .env —
# anything here would be readable by every visitor if it were bundled.
# GEMINI_API_KEY=            # netlify/functions/gemini.js (the proxy all Gemini calls go through)
# SOCIAL_INGEST_URL=         # netlify/functions/fetch-recipe.js (social caption/transcript)
# SOCIAL_INGEST_TOKEN=       # same; the social branch is inert until both are set
